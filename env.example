# PayPal Sandbox credentials, can be obtained from developer.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# Optional: AG Studio licence key for /dashboard.
AG_STUDIO=

# Optional: the AG Studio AI assistant on /dashboard. If blank, an OPENAI_API_KEY already in
# your environment is used instead; with neither, the assistant is hidden.
AG_STUDIO_OPENAI_API_KEY=

# Comma-separated OpenAI model ids for the assistant's model picker; the first is the default.
# If blank, gpt-5.4-mini is used as the default, and no model switcher options are available.
OPENAI_MODELS=gpt-5.6-terra,gpt-5.6-luna,gpt-5.6-sol

# PostgreSQL connection string (required). For local development, either:
#   - a local PostgreSQL in Docker (see README, "Database"):
#       postgresql://quotely:quotely@localhost:5432/quotely
#   - or the Render database's "External Database URL" (add ?sslmode=require if it is not there)
# On Render, the web service gets the "Internal Database URL" in its environment.
DATABASE_URL=

# Webhook id from the PayPal developer dashboard (Apps & Credentials > your sandbox app > Webhooks).
# Needed to verify webhook signatures. Without it, webhook events are accepted in development only.
# See docs/paypal-sandbox-testing.md.
PAYPAL_WEBHOOK_ID=

# Shared secret for scheduler calls to /api/paypal/reconcile and /api/agent/nudge
# (header x-quotely-cron). Any long random string. Optional in development.
QUOTELY_CRON_SECRET=
